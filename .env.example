# =============================================================================
# LogOps Zero-Leak AI Incident Analytics Platform Configuration
# =============================================================================

# Port on which the LogOps UI and API will listen
PORT=8888
LOGOPS_PORT=8888

# Docker image name / tag
LOGOPS_IMAGE=ghcr.io/kisa-ops/logops:v4.1.1
NODE_ENV=production

# -----------------------------------------------------------------------------
# filtr Core Redaction Bridge (Zero-Leak Security Gateway)
# -----------------------------------------------------------------------------
# LogOps offloads all PII, secret, token, and IP masking & rehydration to filtr.
# If filtr is unavailable, LogOps falls back to its built-in in-memory vault.
FILTR_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Local LLM Inference Engine (Ollama / vLLM / Local AI)
# -----------------------------------------------------------------------------
LLM_URL=http://localhost:11434
LLM_MODEL=deepseek-r1:8b
